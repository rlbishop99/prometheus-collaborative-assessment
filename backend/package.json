{
  "name": "@symbol-tracker/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Fastify API that aggregates Yahoo Finance 15-minute bars into daily summaries.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run --exclude 'test/contract/**'",
    "test:watch": "vitest --exclude 'test/contract/**'",
    "test:coverage": "vitest run --coverage --exclude 'test/contract/**'",
    "test:contract": "vitest run test/contract",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "fastify": "^5.12.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.3",
    "tsx": "^4.23.15",
    "vitest": "^5.0.3"
  }
}
